@model HospitalWeb.Models.Patient

@{
    ViewData["Title"] = "Информация о пациенте";
}

<h1>@Model.FullName</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Дата рождения</dt>
    <dd class="col-sm-9">@Model.BirthDate.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">Диагноз</dt>
    <dd class="col-sm-9">@Model.Diagnosis</dd>

    <dt class="col-sm-3">Телефон</dt>
    <dd class="col-sm-9">@Model.Phone</dd>
</dl>

<h4>История приёмов</h4>
@if (Model.Appointments?.Any() == true)
{
    <table class="table table-sm">
        <thead>
            <tr><th>Дата</th><th>Врач</th><th>Примечание</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Appointments)
            {
                <tr>
                    <td>@a.AppointmentDate.ToString("g")</td>
                    <td>@a.Doctor?.FullName (@a.Doctor?.Specialization)</td>
                    <td>@a.Notes</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Приёмов не было.</p>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Изменить</a>
<a asp-action="Index" class="btn btn-secondary">Назад</a>