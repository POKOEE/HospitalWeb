@model IEnumerable<HospitalWeb.Models.Appointment>

@{
    ViewData["Title"] = "Приёмы";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Записи на приём</h1>
    <a asp-action="Create" class="btn btn-success">+ Новый приём</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Записей нет.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Дата и время</th>
                <th>Пациент</th>
                <th>Врач</th>
                <th>Специализация</th>
                <th>Примечание</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@a.Patient?.FullName</td>
                    <td>@a.Doctor?.FullName</td>
                    <td>@a.Doctor?.Specialization</td>
                    <td>@a.Notes</td>
                    <td class="text-end">
                        <a asp-action="Delete" asp-route-id="@a.Id"
                           class="btn btn-sm btn-danger">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}