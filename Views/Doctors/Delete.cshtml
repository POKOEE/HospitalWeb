@model HospitalWeb.Models.Doctor

@{
    ViewData["Title"] = "Удалить врача";
}

<h1 class="text-danger">Удалить врача?</h1>
<div class="alert alert-danger">Это действие нельзя отменить.</div>

<dl class="row">
    <dt class="col-sm-3">ФИО</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Специализация</dt>
    <dd class="col-sm-9">@Model.Specialization</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>