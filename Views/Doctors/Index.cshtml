@model IEnumerable<HospitalWeb.Models.Doctor>

@{
    ViewData["Title"] = "Врачи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Список врачей</h1>
    <a asp-action="Create" class="btn btn-success">+ Добавить врача</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Пока нет ни одного врача.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ФИО</th>
                <th>Специализация</th>
                <th>Кабинет</th>
                <th>Телефон</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.FullName</td>
                    <td>@d.Specialization</td>
                    <td>@d.Office</td>
                    <td>@d.Phone</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-info">Детали</a>
                        <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-warning">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-danger">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}